local function cacheSummary()
	if not WM.cache then return "none" end
	-- Spread=weapon/name: fields inside the matched weapon tables (what we meant
	-- to write) against fields carrying that name anywhere in the cache (what
	-- applygc can write). 0/0 = the game has no such field.
	return string.format("%d entries, %.0fs old, mode=%s, valid=%s, Spread=%d/%d Pen=%d/%d Grav=%d",
		#WM.cache, clock() - WM.lastScan, WM.filterMode, tostring(cacheValid()),
		countEligible(WM.cache, "Spread"), countNumeric(WM.cache, "Spread"),
		countEligible(WM.cache, "Penetration"), countNumeric(WM.cache, "Penetration"),
		countNumeric(WM.cache, "Gravity"))
end

-- what the gravity probe found, with the stock value we remembered for each
local function gravitySummary()
	local names = {}
	for _, k in ipairs(WM.gravKeys or {}) do
		local o = WM.orig[k]
		names[#names + 1] = ((o ~= nil) and string.format("%s(stock %g)", k, o) or k)
			.. (WM.gravPatched[k] and " [we wrote it]" or "")
	end
	if #names == 0 then return "no Gravity-style field found" end
	return table.concat(names, ", ")
end

