--=============================== CONFIG =====================================
local SPREAD_TARGET       = 0      -- No Spread   -> Spread = 0
local PEN_TARGET          = 10     -- Max Pen     -> Penetration = 10 (game max)
-- No Flatline -> the bullet-drop gravity, written every time the module goes
-- on. Not 0: a rifle is sighted in with the bore tilted a hair up, so with an
-- exact 0 drop the round flies straight along that raised bore and looks like
-- it climbs. A whisker above 0 is what flies flat; 0.1 is that value in q (p
-- used 0.2). One fixed number, so No Flatline is a plain toggle.
local DROP_TARGET         = 0.1    -- No Flatline -> drop gravity = 0.1
local GRAVITY_RESTORE     = 75     -- fallback stock value; the real one is
                                   -- remembered from the scan per field
local SETTLE_AFTER_CHANGE = 15     -- if you ask for a change right after a spawn it
                                   -- runs once you have settled (never by itself)
local CACHE_TRUST         = 900    -- "valid" in the Status line means verified within
                                   -- this many seconds (display only - every write
                                   -- re-reads the cache first, see VERIFY_FRESH)
local VERIFY_FRESH        = 5      -- a read-back younger than this is reused, so one job
                                   -- writing several keys only verifies once
local SCAN_WARN           = "30-45" -- wait hint shown while the GC is scanned
local HOLD_LOG_INTERVAL   = 10     -- repeat the "why am I waiting" line this often
local HEARTBEAT_INTERVAL  = 60     -- one console line per minute (crash trail)
-- cache verification: read a sample of the cache straight back out of memory
-- (no writes at all) before trusting a cache the game may have rebuilt
local VERIFY_SAMPLE   = 200        -- fields to read back (one per weapon table)
local VERIFY_MIN_OK   = 4          -- fewer usable reads than this = unknown
local VERIFY_MIN_FAIL = 3          -- this many changed fields is always a rebuild
local VERIFY_MAX_FRAC = 0.25       -- ...or a quarter of the sample, whichever is more.
                                   -- Not 0: one stat the game moved by itself must not
                                   -- force a 30-45s rescan before every single write
local VERIFY_KEYS     = { "Damage", "MuzzleVelocity" }

-- keys we actually change
local CAPTURE_KEYS = { "Spread", "Penetration", "Gravity" }
-- extra keys only used to recognise a real weapon table in the scan
local MARKER_KEYS  = { "Spread", "Penetration", "Gravity", "Damage", "MuzzleVelocity",
                       "Ammo", "ReloadTime", "ShotAmount", "Recoil" }
local MIN_MARKERS  = 2
-- The bullet-drop gravity is NOT a per-weapon field in this game, so No
-- Flatline cannot rely on the weapon-table grouping. These are the names a
-- ballistics config realistically stores it under. "gravity" = the drop
-- gravity itself (75 here), "mult" = a multiplier on the game gravity (1
-- normally). Both mean the same thing to us: 0 = no drop at all.
local GRAVITY_KEYS = {
	{ "Gravity",                 "gravity" },
	{ "gravity",                 "gravity" },
	{ "GRAVITY",                 "gravity" },
	{ "BulletGravity",           "gravity" },
	{ "ProjectileGravity",       "gravity" },
	{ "BallisticGravity",        "gravity" },
	{ "WorldGravity",            "gravity" },
	{ "GlobalGravity",           "gravity" },
	{ "GravityValue",            "gravity" },
	{ "Grav",                    "gravity" },
	{ "GravityScale",            "mult" },
	{ "GravityMultiplier",       "mult" },
	{ "GravityMult",             "mult" },
	{ "GravityFactor",           "mult" },
	{ "BulletGravityMultiplier", "mult" },
	{ "DropMultiplier",          "mult" },
	{ "DropScale",               "mult" },
}
local GRAVITY_BAND_LOW  = 0.25  -- a drop gravity is stored as the game gravity
local GRAVITY_BAND_HIGH = 4     -- itself (75) or a small multiplier near 1
local MULT_MAX          = 10    -- above this it is not a multiplier
-- sanity ranges so we never write into something that is not a weapon stat
local KEY_RANGE = {
	Spread      = { min = 0.0001, max = 500 },
	Penetration = { min = 0.0001, max = 100 },
	Gravity     = { min = 0, max = 500 },
}
-- the values we write. A field that already holds its target still counts as a
-- weapon field, otherwise a fresh scan of an already-patched table comes back
-- empty and the module would look broken after every respawn.
local KEY_TARGETS = {
	Spread      = SPREAD_TARGET,
	Penetration = PEN_TARGET,
	Gravity     = DROP_TARGET,
}
-- every gravity-style name: what kind it is and its trust order
local GRAVITY_KIND  = {}
local GRAVITY_ORDER = {}
for _, g in ipairs(GRAVITY_KEYS) do
	GRAVITY_KIND[g[1]]  = g[2]
	GRAVITY_ORDER[#GRAVITY_ORDER + 1] = g[1]
	-- min 0, not 0.0001: "no drop at all" is a value we deliberately write
	KEY_RANGE[g[1]]     = (g[2] == "gravity") and { min = 0, max = 500 }
		or { min = 0, max = MULT_MAX }
	KEY_TARGETS[g[1]]   = DROP_TARGET
end
-- with one of these open the game may be rebuilding its weapon tables, so
-- queued GC work is held back until it is closed
local MENU_BLOCK_PATTERNS = { "class selection", "equipment selection", "still loading" }

--============================= SHARED STATE =================================
local WM = {
	stopped    = false,
	busy       = false,
	queue      = {},
	cache      = nil,
	scanKeys   = nil,
	weaponSet  = nil,
	filterMode = "tables",   -- "tables" = weapon tables only, "range" = fallback
	lastScan   = 0,
	lastChange = os.clock(),
	verifiedAt  = 0,    -- clock of the last scan / successful read-back
	readType    = nil,  -- calibrated memory_read type (double / float / int)
	lastVerdict = "no cache yet",
	warnedUnknown = false,
	holdLogged  = 0,
	warnCount  = 0,     -- bumped by warn(); a job that warned gets a visible "done"
	forceUntil = 0,
	debug      = false,
	lastOp     = "(idle)",
	lastChar   = nil,
	placeId    = game.PlaceId,
	state      = { recoil = false, spread = false, pen = false, flat = false,
	               worldflat = false },
	-- gravity bookkeeping: which gravity-style keys the game really has, their
	-- stock values (captured while the cache is fresh, before any write) and the
	-- ones we patched, so Restore puts back the right numbers
	gravKeys    = nil,
	orig        = {},
	gravPatched = {},
	worldStock  = nil,
	dropGravity = DROP_TARGET,    -- No Flatline target (fixed)
}

local function clock() return os.clock() end
local function log(msg) print(string.format("[WM %7.2fs] %s", clock(), msg)) end
local function dbg(msg) if WM.debug then print(string.format("[WM %7.2fs] dbg  %s", clock(), msg)) end end

local UI = nil
local syncToggles = function() end   -- filled in once the UI exists
local function notify(title, content, ntype, dur)
	if UI and UI.Alive then
		pcall(function()
			UI:Notify({ Title = title, Content = content, Type = ntype or "info", Duration = dur or 5 })
		end)
	end
end
-- visible to the user: long operations that must not be interrupted
local function warn(msg)
	WM.warnCount = WM.warnCount + 1
	log(msg)
	notify("Weapon Mods", msg, "info", 7)
end
-- errors are always visible
local function fail(msg)
	log(msg)
	notify("Error", msg, "error", 8)
end
-- internal chatter: console line AND popup only when Debug Keys is on
local function note(msg)
	if WM.debug then
		log(msg)
		notify("Weapon Mods", msg, "info", 4)
	end
end

--============================= GAME HELPERS =================================
local Players = game:GetService("Players")

local function lp()
	local ok, p = pcall(function() return Players.LocalPlayer end)
	if ok then return p end
	return nil
end

local function childrenOf(parent)
	if not parent then return nil end
	local ok, kids = pcall(function() return parent:GetChildren() end)
	if ok and type(kids) == "table" then return kids end
	return nil
end

local function toolIn(container)
	local kids = childrenOf(container)
	if not kids then return nil end
	for _, c in ipairs(kids) do
		if c.ClassName == "Tool" then return c end
	end
	return nil
end

local function currentTool()
	local p = lp()
	if not p then return nil end
	local t = toolIn(p.Character)
	if t then return t end
	return toolIn(p:FindFirstChild("Backpack"))
end

local function menuGuiName()
	local p = lp()
	if not p then return nil end
	local pg = p:FindFirstChild("PlayerGui")
	local kids = childrenOf(pg)
	if not kids then return nil end
	for _, g in ipairs(kids) do
		local n = g.Name
		if type(n) == "string" then
			local low = string.lower(n)
			for _, pat in ipairs(MENU_BLOCK_PATTERNS) do
				if string.find(low, pat, 1, true) then return n end
			end
		end
	end
	return nil
end

local function ballisticsClient()
	local p = lp()
	if not p then return nil end
	local ps = p:FindFirstChild("PlayerScripts")
	if not ps then return nil end
	return ps:FindFirstChild("BallisticsClient")
end

-- writes only when the value really has to change, so the 1 Hz watcher is a
-- read and not a write (a per-second write into a game value is a needless
-- risk, and this way we also spot the game clearing the flag)
local function setRecoil(on)
	local bc = ballisticsClient()
	if not bc then return false, "BallisticsClient not found (are you in a match?)", 0 end
	local v = bc:FindFirstChild("DebugShotsGui")
	if not v then return false, "DebugShotsGui not found", 0 end
	local want = on and true or false
	local cur
	local rok, rv = pcall(function() return v.Value end)
	if rok then cur = rv end
	if cur == want then return true, "DebugShotsGui is already " .. tostring(want), 0 end
	local ok = pcall(function() v.Value = want end)
	if not ok then return false, "could not write DebugShotsGui", 0 end
	return true, "DebugShotsGui = " .. tostring(want), 1
end

--============================= TIME / GUARDS ================================
local function alive()
	if WM.stopped then return false end
	if game.PlaceId ~= WM.placeId then return false end
	if lp() == nil then return false end
	return true
end

local function settleLeft()
	local left = SETTLE_AFTER_CHANGE - (clock() - WM.lastChange)
	if left < 0 then left = 0 end
	return left
end

-- nil = safe to touch the GC, otherwise the reason we are waiting
local function guardReason()
	if WM.stopped then return "script stopped" end
	if lp() == nil then return "no LocalPlayer (joining / leaving)" end
	if clock() < WM.forceUntil then return nil end
	local p = lp()
	local ch = p.Character
	if not ch then return "no character yet" end
	local hum = ch:FindFirstChild("Humanoid")
	if not hum then return "no Humanoid yet" end
	local ok, hp = pcall(function() return hum.Health end)
	if not ok or type(hp) ~= "number" or hp <= 0 then return "not alive yet" end
	if not currentTool() then return "waiting for a weapon (deploy / equip first)" end
	local m = menuGuiName()
	if m then return "menu open: " .. m end
	local left = settleLeft()
	if left > 0 then return string.format("settling after spawn / class change (%.0fs left)", left) end
	return nil
end

--============================= GC PRIMITIVES ================================
local function isNumericEntry(e)
	if type(e) ~= "table" then return false end
	if e.type == "number" or e.vtt == 3 then
		return tonumber(e.value) ~= nil
	end
	return false
end

local function numericValueOf(e)
	if type(e) ~= "table" then return nil end
	return tonumber(e.value)
end

local function isFiniteNumber(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function tableKeyOf(e)
	local k = e.tbl or e.table or e.parent or e.tbladdr
	if k == nil then return nil end
	return tostring(k)
end

local function isEligible(e)
	if type(e) ~= "table" then return false end
	local rng = KEY_RANGE[e.key]
	if not rng then return false end
	if not isNumericEntry(e) then return false end
	local v = numericValueOf(e)
	if not isFiniteNumber(v) then return false end
	-- a field that already holds our target stays eligible, so a fresh scan of
	-- an already-patched table is not filtered down to nothing
	local ours = KEY_TARGETS[e.key]
	local alreadyOurs = (ours ~= nil and v == ours)
	if (not alreadyOurs) and (v < rng.min or v > rng.max) then return false end
	if WM.filterMode == "tables" then
		local t = tableKeyOf(e)
		if not t then return false end
		if not (WM.weaponSet and WM.weaponSet[t]) then return false end
	end
	return true
end

local function countEligible(entries, key)
	if not entries then return 0 end
	local n = 0
	for _, e in ipairs(entries) do
		if type(e) == "table" and e.key == key and isEligible(e) then n = n + 1 end
	end
	return n
end

-- how many numeric values sit under this key in the cache at all. applygc
-- writes every entry it finds under a key (it does not know about our weapon
-- table filter), so for the gravity keys this - not countEligible - is the
-- number that matters, both for reporting and for spotting a dead cache.
local function countNumeric(entries, key)
	if not entries then return 0 end
	local n = 0
	for _, e in ipairs(entries) do
		if type(e) == "table" and e.key == key and isNumericEntry(e) then n = n + 1 end
	end
	return n
end

-- the first numeric value we see under a key is the stock value, because a
-- scan only ever runs before a write. 0 is never stock (that would be us), so
-- a 0 sample is ignored rather than remembered.
local function originalValue(entries, key)
	if not entries then return nil end
	for _, e in ipairs(entries) do
		if type(e) == "table" and e.key == key and isNumericEntry(e) then
			local v = numericValueOf(e)
			if isFiniteNumber(v) and v > 0 then return v end
		end
	end
	return nil
end

-- the game's own gravity, used only to judge whether a value looks like a
-- bullet-drop gravity. It is never written to (except by the explicit
-- "World gravity 0" toggle the user has to switch on themselves).
local function gameGravity()
	local g
	pcall(function() g = workspace.Gravity end)
	if type(g) ~= "number" or not (g > 0) then return GRAVITY_RESTORE end
	return g
end

-- does this look like the gravity the drop is computed from?
local function looksLikeDropGravity(v, kind)
	if not isFiniteNumber(v) then return false end
	-- near zero is effectively flat, and that is the value we write ourselves
	if v <= 1 then return true end
	if v < 0 then return false end
	if kind == "mult" then return v <= MULT_MAX end
	local g = gameGravity()
	return v >= g * GRAVITY_BAND_LOW and v <= g * GRAVITY_BAND_HIGH
end

-- one console line per gravity-style name that exists in the cache. This is
-- the line that says whether the drop gravity is a GC value at all.
local function gravityProbe(entries)
	local lines = {}
	for _, key in ipairs(GRAVITY_ORDER) do
		local n = countNumeric(entries, key)
		if n > 0 then
			local samples, inTables = {}, 0
			for _, e in ipairs(entries) do
				if type(e) == "table" and e.key == key and isNumericEntry(e) then
					local t = tableKeyOf(e)
					if t and WM.weaponSet and WM.weaponSet[t] then inTables = inTables + 1 end
					if #samples < 3 then
						local v = numericValueOf(e)
						if isFiniteNumber(v) then
							samples[#samples + 1] = string.format("%g", v)
						end
					end
				end
			end
			local judge = ""
			if #samples > 0 then
				judge = looksLikeDropGravity(tonumber(samples[1]), GRAVITY_KIND[key] or "gravity")
					and " <- likely the drop gravity" or " <- not a drop value"
			end
			lines[#lines + 1] = string.format("%s: %d numeric (%d in weapon tables, values %s)%s",
				key, n, inTables,
				#samples > 0 and table.concat(samples, ", ") or "n/a", judge)
		end
	end
	return lines
end

-- expected = the number of entries applygc can realistically write for a key
local function expectedCount(entries, key)
	if GRAVITY_KIND[key] then return countNumeric(entries, key) end
	return countEligible(entries, key)
end

local function rebuildWeaponSet(entries)
	local groups, anyTableInfo = {}, false
	for _, e in ipairs(entries) do
		if type(e) == "table" then
			local t = tableKeyOf(e)
			if t then
				anyTableInfo = true
				local g = groups[t]
				if not g then g = { m = 0, keys = {} }; groups[t] = g end
				if not g.keys[e.key] then
					g.keys[e.key] = true
					for _, m in ipairs(MARKER_KEYS) do
						if e.key == m then g.m = g.m + 1 end
					end
				end
			end
		end
	end
	local set, matched = {}, 0
	for t, g in pairs(groups) do
		if g.m >= MIN_MARKERS then set[t] = true; matched = matched + 1 end
	end
	return set, matched, anyTableInfo
end

-- returns ok, fields written, error, stale
-- "stale" means the cached addresses no longer point at live weapon tables, so
-- the cache is thrown away instead of being written into
local function applyCached(key, target)
	if not WM.cache then return false, 0, "no cache", false end
	local expected = expectedCount(WM.cache, key)
	local t0 = clock()
	local ok, res = pcall(applygc, WM.cache, key, target)
	if not ok then return false, 0, tostring(res), false end
	local n = tonumber(res) or 0
	dbg(string.format("%s: %d of %d field(s) in %.2fs", key, n, expected, clock() - t0))
	-- applygc writes every entry it finds under a key, not just the ones inside the
	-- matched weapon tables: expected is what we meant to write, n is what it
	-- really touched. More written than expected = it reached past the weapon
	-- tables, which is worth one line in the console.
	if n > expected then
		log(string.format("%s: wrote %d field(s), more than the %d inside the matched weapon tables",
			key, n, expected))
	end
	if n == 0 and expected > 0 then
		WM.cache = nil
		WM.weaponSet = nil
		dbg("cache addresses are dead (0 fields matched) - dropped the cache")
		return false, 0, "the cached addresses are stale", true
	end
	return true, n, nil, false
end

-- usable = a scan or a successful read-back confirmed it recently. Time alone
-- never marks a cache stale in a way that costs a scan: an old cache is read
-- back first (see verifyCache), which is free.
local function cacheValid()
	if not WM.cache then return false end
	if (clock() - WM.verifiedAt) >= CACHE_TRUST then return false end
	return true
end

-- a cache that turned out to be dead is thrown away so the next explicit write
-- scans again. The toggles stay exactly as the user left them.
local function dropCache(reason)
	if not WM.cache then return end
	WM.cache = nil
	WM.weaponSet = nil
	dbg("cache dropped (" .. reason .. ")")
end

--====================== CACHE VERIFICATION (READ ONLY) ======================
-- Reads a sample of the cached values straight back out of memory. There is no
-- write anywhere in here, so the worst a misread can do is make us rescan.
local function readAt(addr, typ)
	local ok, v = pcall(memory_read, typ, addr)
	if ok and type(v) == "number" then return v end
	return nil
end

-- true = the field is still exactly what we scanned, false = it changed,
-- nil = we cannot even address it (not counted either way)
local function readMatches(e, expect)
	local a = tonumber(e.addr)
	if not a then return nil end
	local order = { "double", "float", "int" }
	if WM.readType then
		local rest = { WM.readType }
		for _, t in ipairs(order) do if t ~= WM.readType then table.insert(rest, t) end end
		order = rest
	end
	local tol = math.max(1e-9, math.abs(expect) * 1e-6)
	for _, t in ipairs(order) do
		local v = readAt(a, t)
		if v and math.abs(v - expect) <= tol then
			WM.readType = t
			return true
		end
	end
	return false
end

-- "alive"   = the addresses still hold the same weapon values (safe to write)
-- "dead"    = they hold something else (the game rebuilt its tables)
-- "unknown" = not enough readable fields to judge (treated as dead)
local function verifyCache()
	if not WM.cache then return "unknown" end
	local t0 = clock()
	local okn, fail, seen, tables = 0, 0, 0, {}
	for _, e in ipairs(WM.cache) do
		if seen >= VERIFY_SAMPLE then break end
		if type(e) == "table" and isNumericEntry(e) then
			local expect = numericValueOf(e)
			local marker = false
			for _, k in ipairs(VERIFY_KEYS) do if e.key == k then marker = true end end
			if marker and isFiniteNumber(expect) and expect ~= 0 then
				local t = tableKeyOf(e)
				if not (t and tables[t]) then
					if t then tables[t] = true end
					local m = readMatches(e, expect)
					if m ~= nil then
						seen = seen + 1
						if m then okn = okn + 1 else fail = fail + 1 end
					end
				end
			end
		end
	end
	-- judge on a fraction, not a single field: a rebuilt table changes nearly
	-- every value, while a live one can legitimately drift in one or two
	local allowed = math.max(VERIFY_MIN_FAIL, math.floor(seen * VERIFY_MAX_FRAC))
	local verdict
	if fail > allowed then
		verdict = "dead"
	elseif (okn + fail) < VERIFY_MIN_OK then
		verdict = "unknown"
	elseif okn >= VERIFY_MIN_OK then
		verdict = "alive"
	else
		verdict = "unknown"
	end
	WM.lastVerdict = string.format("%s - %d of %d fields still match (%d changed, limit %d, %.2fs, %s)",
		verdict, okn, seen, fail, allowed, clock() - t0, tostring(WM.readType))
	dbg("cache check: " .. WM.lastVerdict)
	return verdict
end

--============================= HEAVY JOBS ===================================
local function mergedScanKeys()
	local keys = {}
	for _, k in ipairs(CAPTURE_KEYS) do table.insert(keys, k) end
	for _, k in ipairs({ "Damage", "MuzzleVelocity" }) do table.insert(keys, k) end
	-- every gravity name the drop could be stored under: same scan, no extra
	-- wait for the user
	for _, k in ipairs(GRAVITY_ORDER) do table.insert(keys, k) end
	return keys
end

local function jobScan()
	local t0 = clock()
	warn("scanning the GC now - do not touch anything, do not switch class / weapon for about " .. SCAN_WARN .. " seconds")
	local keys = mergedScanKeys()
	local ok, entries = pcall(getgc, keys)
	if not ok then
		WM.cache = nil
		WM.weaponSet = nil
		fail("getgc failed: " .. tostring(entries))
		return
	end
	if type(entries) ~= "table" then
		WM.cache = nil
		fail("getgc returned " .. type(entries) .. " instead of a table - scan cancelled")
		return
	end
	if not alive() then dbg("scan aborted - player left the game"); return end
	local total = 0
	for _, e in ipairs(entries) do if type(e) == "table" then total = total + 1 end end

	local set, matched, anyTableInfo = rebuildWeaponSet(entries)
	local counts = {}
	for _, k in ipairs(CAPTURE_KEYS) do counts[k] = 0 end

	WM.cache       = entries
	WM.weaponSet   = set
	WM.scanKeys    = keys
	WM.filterMode  = "tables"
	WM.verifiedAt  = clock()
	WM.lastVerdict = "fresh scan - trusted"
	if (not anyTableInfo) or matched == 0 then
		WM.filterMode = "range"
		note("no weapon-table grouping available - falling back to value ranges")
	end
	for _, k in ipairs(CAPTURE_KEYS) do counts[k] = countEligible(entries, k) end
	WM.lastScan = clock()

	-- gravity: remember the stock value of every gravity-style key that exists
	-- (the cache is fresh right now and nothing has been written yet) and print
	-- the probe line, so a No Flatline that still does nothing is diagnosable
	WM.gravKeys = {}
	for _, key in ipairs(GRAVITY_ORDER) do
		if countNumeric(entries, key) > 0 then
			WM.gravKeys[#WM.gravKeys + 1] = key
			local o = originalValue(entries, key)
			local kept = WM.orig[key]
			if o ~= nil and (kept == nil or (kept == WM.dropGravity and o ~= WM.dropGravity)) then
				WM.orig[key] = o
			end
		end
	end
	-- plausible names first, so the report names the real suspect at the front
	table.sort(WM.gravKeys, function(a, b)
		local la = looksLikeDropGravity(WM.orig[a], GRAVITY_KIND[a])
		local lb = looksLikeDropGravity(WM.orig[b], GRAVITY_KIND[b])
		if la ~= lb then return la end
		return a < b
	end)
	local probe = gravityProbe(entries)
	if #probe > 0 then
		for _, line in ipairs(probe) do log("gravity probe: " .. line) end
	else
		log("gravity probe: no Gravity-style field in the GC - the drop is not stored in a Lua table here")
	end

	-- one always-visible line per scan, so "does this stat even exist in the GC?"
	-- can be answered from the scan itself, without Debug Keys
	log(string.format("scan report: Spread %d/%d, Penetration %d/%d, Gravity %d (in weapon tables / with that name)",
		countEligible(entries, "Spread"), countNumeric(entries, "Spread"),
		countEligible(entries, "Penetration"), countNumeric(entries, "Penetration"),
		countNumeric(entries, "Gravity")))
	dbg(string.format("scan: %d entries in %.1fs, weapon tables matched: %d", total, clock() - t0, matched))
	dbg(string.format("cache ready: Spread=%d/%d Penetration=%d/%d Gravity=%d",
		counts.Spread, countNumeric(entries, "Spread"),
		counts.Penetration, countNumeric(entries, "Penetration"), counts.Gravity))
	dbg(string.format("GC scan done in %.1fs - %d entries, %d weapon table(s), mode=%s",
		clock() - t0, total, matched, WM.filterMode))
	note(string.format("scan complete - %d entries, %d weapon tables", total, matched))
end

-- Makes sure a usable cache exists. This is only ever reached from a toggle
-- or a button - nothing calls it by itself. A cache that is not trusted is
-- read back first (read only, milliseconds); a real rebuild costs one scan.
local function ensureCache()
	-- A read-back that just happened (the same job writing several keys) is
	-- reused. Anything older than VERIFY_FRESH is read straight out of memory
	-- again before a single value is written: the game rebuilds its gun tables
	-- on respawn / weapon changes, and writing into a rebuilt cache lands in
	-- recycled memory that can still report success. Read only - milliseconds -
	-- so the only thing this can ever cost is one scan, when it is really needed.
	if WM.cache and (clock() - WM.verifiedAt) < VERIFY_FRESH then
		dbg(string.format("cache verified %.1fs ago - writing through it", clock() - WM.verifiedAt))
		return
	end
	if WM.cache then
		local verdict = verifyCache()
		if verdict == "alive" then
			WM.verifiedAt = clock()
			note("cache still matches - re-using it (" .. WM.lastVerdict .. ")")
			return
		end
		if verdict == "unknown" and not WM.warnedUnknown then
			WM.warnedUnknown = true
			warn("cannot read the cache back (unsafe Lua / memory_read off?) - one scan is needed before the next change")
		end
		dropCache(verdict == "dead" and "the cached weapon tables are gone (the game rebuilt them)" or "cache could not be verified")
	end
	jobScan()
end

-- the toggle that has to be on for a key to be worth writing
local KEY_STATE = { Spread = "spread", Penetration = "pen", Gravity = "flat" }

-- one cached write; a dead cache is rebuilt ONCE and the write retried, because
-- the user asked for this value right now
local function applyWithRetry(key, target)
	ensureCache()
	if not alive() then return false, 0, "player left the game" end
	local ok, n, err, stale = applyCached(key, target)
	if (not ok) and stale then
		dbg("cache was stale - one fresh scan, then retry " .. key)
		ensureCache()
		if not alive() then return false, 0, "player left the game" end
		ok, n, err = applyCached(key, target)
	end
	return ok, n, err
end

-- Spread / Max Pen / No Flatline all go through the scanned, weapon-table-only
-- cache now. There is no unfiltered global write left in this script.
local function jobApplyKey(key, target)
	local st = KEY_STATE[key]
	if st and not WM.state[st] then
		dbg(key .. " job skipped - the module was switched off again")
		return
	end
	local ok, n, err = applyWithRetry(key, target)
	if not ok then
		fail("could not apply " .. key .. ": " .. tostring(err))
		return
	end
	if n == 0 then
		-- two very different reasons for "nothing written": the game has no field
		-- with that name at all (the module cannot work), or the fields are there
		-- but the cache no longer points at the live tables
		local have = countNumeric(WM.cache, key)
		if have == 0 then
			warn(key .. ": the GC holds no field called " .. key .. " - deploy into a match with the weapon out, then flip the module on again")
		else
			warn(string.format("%s: %d field(s) with that name, but none took the write - the cached addresses look stale. Press Re-apply now, or rejoin and flip it on again",
				key, have))
		end
		return
	end
	-- always in the console (F9), no popup: this is the only visible proof that
	-- the module did anything, because the change itself cannot be seen in game
	log(string.format("%s -> %s: %d field(s) written", key, tostring(target), n))
end

local function worldGravityNow()
	local g
	pcall(function() g = workspace.Gravity end)
	return (type(g) == "number") and g or nil
end

-- the gravity keys this cache can write to, in trust order: what the scan saw
-- first, and if the scan saw none then plain "Gravity" is still worth a call
local function gravityKeyList()
	local out = {}
	for _, k in ipairs(WM.gravKeys or {}) do out[#out + 1] = k end
	if #out == 0 then out[1] = "Gravity" end
	return out
end

-- what a multiplier-style field has to hold for the bullet's drop gravity to
-- end up at the drop target: a multiplier on the game gravity (75) is that
-- fraction of it, an absolute gravity field just gets the number itself
local function multForValue(v)
	local g = gameGravity()
	if not (g and g > 0) then g = GRAVITY_RESTORE end
	return v / g
end

-- The fields this write touches and the number each one gets: every
-- gravity-style field the scan found. An absolute gravity field gets the drop
-- target itself, a multiplier field gets its share of the game gravity.
local function gravityWritePlan(target, mode)
	local plan = {}
	for _, key in ipairs(gravityKeyList()) do
		if key then
			local kind = GRAVITY_KIND[key] or "gravity"
			local value
			if mode == "restore" then
				value = WM.orig[key]
				if value == nil or value <= 0 then
					value = (kind == "mult") and 1 or GRAVITY_RESTORE
				end
			elseif kind == "mult" then
				value = multForValue(target)
			else
				value = target
			end
			plan[#plan + 1] = { key, value }
		end
	end
	return plan
end

-- Writes the drop target - or the stock values back - to the planned gravity
-- fields. Returns fields written, a readable report, how many keys were worth
-- trying, and an error.
local function applyGravityFamily(target, mode)
	ensureCache()
	if not alive() then return 0, {}, 0, "player left the game" end
	local total, parts, planned = 0, {}, 0
	for _, item in ipairs(gravityWritePlan(target, mode)) do
		local key, value = item[1], item[2]
		local n = countNumeric(WM.cache, key)
		-- a key with nothing in the cache is only worth the call while setting
		-- the flat value: that is how a key the scan missed is still caught
		if n > 0 or mode == "flat" then
			planned = planned + 1
			local ok, wrote, err = applyWithRetry(key, value)
			if not ok then
				parts[#parts + 1] = key .. " failed (" .. tostring(err) .. ")"
			else
				total = total + wrote
				parts[#parts + 1] = string.format("%s=%d->%g", key, wrote, value)
				if wrote > 0 then WM.gravPatched[key] = true end
			end
		else
			parts[#parts + 1] = key .. " not in the cache"
		end
	end
	return total, parts, planned, nil
end

-- Explicit and off by default: writes workspace.Gravity on your own client.
local function cmdWorldFlat(on)
	WM.state.worldflat = on and true or false
	if on then
		local cur = worldGravityNow()
		if WM.worldStock == nil then
			WM.worldStock = (cur and cur > 0) and cur or GRAVITY_RESTORE
		end
		local ok, err = pcall(function() workspace.Gravity = 0 end)
		if not ok then
			WM.state.worldflat = false
			syncToggles()
			fail("could not change world gravity: " .. tostring(err))
			return
		end
		log("world gravity = 0 (client side only)")
		warn(string.format("world gravity is 0 now (stock %g) - if your character floats or the game complains, flip this off at once", WM.worldStock))
	else
		local back = WM.worldStock
		if back ~= nil then
			local ok, err = pcall(function() workspace.Gravity = back end)
			if ok then
				log(string.format("world gravity back to %g", back))
			else
				fail("could not restore world gravity: " .. tostring(err))
			end
			WM.worldStock = nil
		end
	end
end

-- The drop gravity is not a gun stat, so it does not live in the weapon
-- tables the scan groups. These helpers write the drop target (or the stock
-- values back) to whichever gravity-style names the game really has.

local function jobFlatline()
	if not WM.state.flat then
		dbg("Gravity job skipped - the module was switched off again")
		return
	end
	local total, parts, planned, err = applyGravityFamily(WM.dropGravity, "flat")
	if err then
		fail("could not apply No Flatline: " .. tostring(err))
		return
	end
	if total == 0 then
		warn("No Flatline: nothing to write (" .. table.concat(parts, ", ")
			.. ") - if the probe line said there is no Gravity-style field, use World gravity 0")
		return
	end
	note("No Flatline: " .. table.concat(parts, ", "))
	log(string.format("no flatline: %d field(s) at drop gravity %g (%s)",
		total, WM.dropGravity, table.concat(parts, ", ")))
end

local function jobRestoreGravity()
	local total, parts, planned, err = applyGravityFamily(nil, "restore")
	WM.state.flat = false
	WM.state.worldflat = false
	local back = WM.worldStock
	if back ~= nil then
		local ok = pcall(function() workspace.Gravity = back end)
		WM.worldStock = nil
		if ok then log(string.format("world gravity back to %g", back)) end
	end
	syncToggles()
	if err then
		fail("could not restore Gravity: " .. tostring(err))
		return
	end
	if total == 0 then
		warn("Restore Gravity: nothing was written back (" .. table.concat(parts, ", ") .. ")")
		return
	end
	note("Gravity restored: " .. table.concat(parts, ", "))
	log("gravity restored: " .. table.concat(parts, ", "))
end

-- Puts every module that is switched on back the way the user left it. Only
-- the Re-apply button calls this now - nothing runs it by itself. The cache is
-- read back first, so it is instant while the game is still using the same
-- tables, and only a real rebuild costs one fresh scan.
local function jobRestoreMods()
	local wanted = {}
	if WM.state.spread then table.insert(wanted, { "Spread", SPREAD_TARGET, "spread" }) end
	if WM.state.pen    then table.insert(wanted, { "Penetration", PEN_TARGET, "pen" }) end
	if #wanted == 0 and not WM.state.flat then
		dbg("restore: no module is switched on")
		return
	end
	local did, problems = {}, {}
	for _, m in ipairs(wanted) do
		local key, target, st = m[1], m[2], m[3]
		local ok, n, err = applyWithRetry(key, target)
		if ok and n > 0 then
			table.insert(did, key .. "=" .. n)
		else
			WM.state[st] = false
			table.insert(problems, key .. " (" .. tostring(err or "no live field") .. ")")
		end
	end
	-- No Flatline goes through the gravity family, not through a single
	-- "Gravity" field, so it is written the same way the module does it
	if WM.state.flat then
		local total, parts, planned, err = applyGravityFamily(WM.dropGravity, "flat")
		if err or total == 0 then
			WM.state.flat = false
			table.insert(problems, "Gravity (" .. tostring(err or table.concat(parts, ", ")) .. ")")
		else
			table.insert(did, "Gravity=" .. total)
		end
	end
	if #problems > 0 then
		syncToggles()
		warn("could not put back " .. table.concat(problems, ", ") .. " - that module was switched off, flip it to retry")
	end
	if #did > 0 then note("restored: " .. table.concat(did, " ")) end
end

--============================= OPERATION QUEUE ==============================
local pump
pump = function()
	if WM.stopped or WM.busy then return end
	local job = WM.queue[1]
	if not job then return end
	local reason = guardReason()
	if reason then
		-- No timer here on purpose: task.delay does not run its callback in this
		-- build. The job stays at the head of the queue and the 1 Hz watcher
		-- retries it (see the watcher) until the guard clears by itself.
		if not job.heldOnce then
			job.heldOnce = true
			WM.holdLogged = clock()
			warn("waiting to run '" .. job.name .. "' - " .. reason)
		elseif (clock() - WM.holdLogged) > HOLD_LOG_INTERVAL then
			WM.holdLogged = clock()
			log(string.format("still waiting to run '%s' - %s (it starts by itself as soon as that clears)",
				job.name, reason))
		end
		return
	end
	table.remove(WM.queue, 1)
	WM.busy = true
	WM.lastOp = job.name
	task.spawn(function()
		local t0 = clock()
		local warned = WM.warnCount
		dbg("OP START: " .. job.name)
		local ok, err = pcall(job.fn)
		WM.busy = false
		if ok then
			if WM.warnCount > warned then
				log(string.format("done - %s (%.1fs)", job.name, clock() - t0))
			end
			dbg(string.format("OP DONE: %s (%.1fs)", job.name, clock() - t0))
		else
			fail(string.format("OP FAILED: %s -> %s", job.name, tostring(err)))
		end
		WM.lastOp = "(idle)"
		-- task.delay is a no-op in this build, so the continuation is a thread
		-- that really does wait - without it the next queued job never started
		task.spawn(function()
			wait(0.3)
			pump()
		end)
	end)
end

local function enqueue(name, fn)
	if WM.stopped then dbg("ignored '" .. name .. "' - script is stopped"); return end
	table.insert(WM.queue, { name = name, fn = fn })
	if #WM.queue > 1 or WM.busy then
		dbg("queued: " .. name .. " (waiting for the operation in front of it)")
	else
		dbg("queued: " .. name)
	end
	pump()
end

--============================= TOGGLES ======================================
local function toggle(key, on)
	WM.state[key] = on
	if key == "recoil" then
		local ok, msg = setRecoil(on)
		dbg("No Recoil " .. (on and "on" or "off") .. " -> " .. tostring(msg))
		if not ok then notify("No Recoil", msg, "error", 6) end
		return
	end
	if key == "spread" then
		if on then
			enqueue("No Spread ON (Spread -> " .. SPREAD_TARGET .. ")", function()
				jobApplyKey("Spread", SPREAD_TARGET)
			end)
		else
			note("No Spread off - the value stays patched. Rejoin to reset it.")
		end
		return
	end
	if key == "pen" then
		if on then
			enqueue("Max Pen ON (Penetration -> " .. PEN_TARGET .. ")", function()
				jobApplyKey("Penetration", PEN_TARGET)
			end)
		else
			note("Max Pen off - the value stays patched. Rejoin to reset it.")
		end
		return
	end
	if key == "flat" then
		if on then
			-- uses the shared cache: instant when it is warm, otherwise the same one
			-- scan as No Spread / Max Pen
			enqueue("No Flatline ON (drop gravity -> " .. string.format("%g", WM.dropGravity) .. ")", jobFlatline)
		else
			note("No Flatline off - gravity stays " .. string.format("%g", WM.dropGravity) .. " until you press Restore Gravity.")
		end
		return
	end
end

