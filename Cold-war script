-- Reads the game's own ballistics code and prints only the interesting lines.
-- This is how the real field names and the real math get found instead of
-- guessed: if the client never computes spread / penetration / drop, no write
-- into a client table can ever change them, and one look at the source says so.
-- Read only - no value is written by this.
local DUMP_KEYWORDS = { "Spread", "Penetration", "Gravity", "Recoil", "Drop",
                        "Ballistic", "MuzzleVelocity", "ShotAmount", "Flatline" }
local DUMP_PATTERNS = { "ballistic", "weapon", "gun", "spread", "penetrat" }
local DUMP_MAX_LINES = 250

local function cmdDump()
	local ok, list = pcall(getscripts)
	if not ok or type(list) ~= "table" then
		fail("could not list the game's scripts (getscripts failed)")
		return
	end
	log(string.format("%d script(s) loaded - decompiling the ballistics / weapon ones", #list))
	local tried, hits = 0, 0
	for _, s in ipairs(list) do
		local name, path
		pcall(function() name = s.Name; path = s:GetFullName() end)
		if type(path) == "string" and type(name) == "string" then
			local low = string.lower(path)
			local wanted = false
			for _, pat in ipairs(DUMP_PATTERNS) do
				if string.find(low, pat, 1, true) then wanted = true; break end
			end
			if wanted then
				tried = tried + 1
				local dok, src = pcall(decompile, s)
				if dok and type(src) == "string" and #src > 0 then
					log(string.format("--- %s (%d chars) ---", path, #src))
					local n = 0
					for line in string.gmatch(src, "[^\n]*") do
						n = n + 1
						local match = false
						for _, kw in ipairs(DUMP_KEYWORDS) do
							if string.find(line, kw, 1, true) then match = true; break end
						end
						if match then
							hits = hits + 1
							if hits > DUMP_MAX_LINES then
								log("... cut off after " .. DUMP_MAX_LINES .. " matching lines")
								break
							end
							print(string.format("  %s:%d  %s", name, n, line))
						end
					end
				else
					log("could not decompile " .. path)
				end
			end
		end
	end
	if tried == 0 then
		log("no script named like ballistics / weapon / gun was found - nothing to dump")
	else
		log(string.format("dumped %d matching line(s) from %d script(s) - scroll up, F9", hits, tried))
	end
end

