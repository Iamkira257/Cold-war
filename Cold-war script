local function cacheSummary()
	if not WM.cache then return "none" end
	return string.format("%d entries, %.0fs old, mode=%s, valid=%s, Spread=%d Pen=%d Grav=%d",
		#WM.cache, clock() - WM.lastScan, WM.filterMode, tostring(cacheValid()),
		countEligible(WM.cache, "Spread"), countEligible(WM.cache, "Penetration"),
		countEligible(WM.cache, "Gravity"))
end

local function cmdStatus()
	local p = lp()
	local tool = currentTool()
	print("----------------------------------------------------------")
	print(BANNER)
	print(string.format("  stopped=%s busy=%s lastOp=%s queue=%d",
		tostring(WM.stopped), tostring(WM.busy), WM.lastOp, #WM.queue))
	print(string.format("  toggles: recoil=%s spread=%s pen=%s flat=%s",
		tostring(WM.state.recoil), tostring(WM.state.spread),
		tostring(WM.state.pen), tostring(WM.state.flat)))
	print(string.format("  LocalPlayer=%s character=%s tool=%s",
		p and p.Name or "nil", (p and p.Character) and p.Character.Name or "nil",
		tool and tool.Name or "nil"))
	print(string.format("  menu gui=%s settle left=%.0fs placeId=%d",
		tostring(menuGuiName()), settleLeft(), WM.placeId))
	print(string.format("  guard: %s", tostring(guardReason()) or "SAFE - GC may be touched"))
	print(string.format("  cache: %s", cacheSummary()))
	-- read-only cache check: press Status after a death to see whether the cached
	-- addresses are still live. No scan and no write happens in here.
	if WM.cache and not WM.busy then pcall(verifyCache) end
	print(string.format("  cache check: %s", WM.lastVerdict))
	print("----------------------------------------------------------")
end

