local BANNER = "Weapon Mods build 2026-09-25m"
print(BANNER .. " - loading")

-- stop a previous copy of this script (its watcher and its queue)
pcall(function()
	local old = _G and _G.WM
	if old and type(old.stop) == "function" then old.stop() end
end)

--=============================== CONFIG =====================================
local SPREAD_TARGET       = 0      -- No Spread   -> Spread = 0
local PEN_TARGET          = 10     -- Max Pen     -> Penetration = 10 (game max)
local GRAVITY_TARGET      = 0      -- No Flatline -> Gravity = 0 (exact 0 drop)
local GRAVITY_RESTORE     = 75     -- stock value
local SETTLE_AFTER_CHANGE = 15     -- if you ask for a change right after a spawn it
                                   -- runs once you have settled (never by itself)
local CACHE_TRUST         = 900    -- older than this the cache is re-read once (read
                                   -- only, ms) before being written through - a
                                   -- read-back, never a scan
local SCAN_WARN           = "30-45" -- wait hint shown while the GC is scanned
local HOLD_LOG_INTERVAL   = 10     -- repeat the "why am I waiting" line this often
local HEARTBEAT_INTERVAL  = 60     -- one console line per minute (crash trail)
-- cache verification: read a sample of the cache straight back out of memory
-- (no writes at all) before trusting a cache the game may have rebuilt
local VERIFY_SAMPLE   = 200        -- fields to read back (one per weapon table)
local VERIFY_MIN_OK   = 4          -- fewer usable reads than this = unknown
local VERIFY_MAX_FAIL = 0          -- any field that no longer matches = rebuilt
local VERIFY_KEYS     = { "Damage", "MuzzleVelocity" }

-- keys we actually change
local CAPTURE_KEYS = { "Spread", "Penetration", "Gravity" }
-- extra keys only used to recognise a real weapon table in the scan
local MARKER_KEYS  = { "Spread", "Penetration", "Gravity", "Damage", "MuzzleVelocity",
                       "Ammo", "ReloadTime", "ShotAmount", "Recoil" }
local MIN_MARKERS  = 2
-- sanity ranges so we never write into something that is not a weapon stat
local KEY_RANGE = {
	Spread      = { min = 0.0001, max = 500 },
	Penetration = { min = 0.0001, max = 100 },
	Gravity     = { min = 0.0001, max = 500 },
}
-- the values we write. A field that already holds its target still counts as a
-- weapon field, otherwise a fresh scan of an already-patched table comes back
-- empty and the module would look broken after every respawn.
local KEY_TARGETS = {
	Spread      = SPREAD_TARGET,
	Penetration = PEN_TARGET,
	Gravity     = GRAVITY_TARGET,
}
-- with one of these open the game may be rebuilding its weapon tables, so
-- queued GC work is held back until it is closed
local MENU_BLOCK_PATTERNS = { "class selection", "equipment selection", "still loading" }

--============================= SHARED STATE =================================
local WM = {
	stopped    = false,
	busy       = false,
	queue      = {},
	cache      = nil,
	scanKeys   = nil,
	weaponSet  = nil,
	filterMode = "tables",   -- "tables" = weapon tables only, "range" = fallback
	lastScan   = 0,
	lastChange = os.clock(),
	verifiedAt  = 0,    -- clock of the last scan / successful read-back
	readType    = nil,  -- calibrated memory_read type (double / float / int)
	lastVerdict = "no cache yet",
	warnedUnknown = false,
	holdLogged  = 0,
	warnCount  = 0,     -- bumped by warn(); a job that warned gets a visible "done"
	forceUntil = 0,
	debug      = false,
	lastOp     = "(idle)",
	lastChar   = nil,
	placeId    = game.PlaceId,
	state      = { recoil = false, spread = false, pen = false, flat = false },
}

local function clock() return os.clock() end
local function log(msg) print(string.format("[WM %7.2fs] %s", clock(), msg)) end
local function dbg(msg) if WM.debug then print(string.format("[WM %7.2fs] dbg  %s", clock(), msg)) end end

local UI = nil
local syncToggles = function() end   -- filled in once the UI exists
local function notify(title, content, ntype, dur)
	if UI and UI.Alive then
		pcall(function()
			UI:Notify({ Title = title, Content = content, Type = ntype or "info", Duration = dur or 5 })
		end)
	end
end
-- visible to the user: long operations that must not be interrupted
local function warn(msg)
	WM.warnCount = WM.warnCount + 1
	log(msg)
	notify("Weapon Mods", msg, "info", 7)
end
-- errors are always visible
local function fail(msg)
	log(msg)
	notify("Error", msg, "error", 8)
end
-- internal chatter: console line AND popup only when Debug Keys is on
local function note(msg)
	if WM.debug then
		log(msg)
		notify("Weapon Mods", msg, "info", 4)
	end
end

--============================= GAME HELPERS =================================
local Players = game:GetService("Players")

local function lp()
	local ok, p = pcall(function() return Players.LocalPlayer end)
	if ok then return p end
	return nil
end

local function childrenOf(parent)
	if not parent then return nil end
	local ok, kids = pcall(function() return parent:GetChildren() end)
	if ok and type(kids) == "table" then return kids end
	return nil
end

local function toolIn(container)
	local kids = childrenOf(container)
	if not kids then return nil end
	for _, c in ipairs(kids) do
		if c.ClassName == "Tool" then return c end
	end
	return nil
end

local function currentTool()
	local p = lp()
	if not p then return nil end
	local t = toolIn(p.Character)
	if t then return t end
	return toolIn(p:FindFirstChild("Backpack"))
end

local function menuGuiName()
	local p = lp()
	if not p then return nil end
	local pg = p:FindFirstChild("PlayerGui")
	local kids = childrenOf(pg)
	if not kids then return nil end
	for _, g in ipairs(kids) do
		local n = g.Name
		if type(n) == "string" then
			local low = string.lower(n)
			for _, pat in ipairs(MENU_BLOCK_PATTERNS) do
				if string.find(low, pat, 1, true) then return n end
			end
		end
	end
	return nil
end

local function ballisticsClient()
	local p = lp()
	if not p then return nil end
	local ps = p:FindFirstChild("PlayerScripts")
	if not ps then return nil end
	return ps:FindFirstChild("BallisticsClient")
end

-- writes only when the value really has to change, so the 1 Hz watcher is a
-- read and not a write (a per-second write into a game value is a needless
-- risk, and this way we also spot the game clearing the flag)
local function setRecoil(on)
	local bc = ballisticsClient()
	if not bc then return false, "BallisticsClient not found (are you in a match?)", 0 end
	local v = bc:FindFirstChild("DebugShotsGui")
	if not v then return false, "DebugShotsGui not found", 0 end
	local want = on and true or false
	local cur
	local rok, rv = pcall(function() return v.Value end)
	if rok then cur = rv end
	if cur == want then return true, "DebugShotsGui is already " .. tostring(want), 0 end
	local ok = pcall(function() v.Value = want end)
	if not ok then return false, "could not write DebugShotsGui", 0 end
	return true, "DebugShotsGui = " .. tostring(want), 1
end

--============================= TIME / GUARDS ================================
local function alive()
	if WM.stopped then return false end
	if game.PlaceId ~= WM.placeId then return false end
	if lp() == nil then return false end
	return true
end

local function settleLeft()
	local left = SETTLE_AFTER_CHANGE - (clock() - WM.lastChange)
	if left < 0 then left = 0 end
	return left
end

-- nil = safe to touch the GC, otherwise the reason we are waiting
local function guardReason()
	if WM.stopped then return "script stopped" end
	if lp() == nil then return "no LocalPlayer (joining / leaving)" end
	if clock() < WM.forceUntil then return nil end
	local p = lp()
	local ch = p.Character
	if not ch then return "no character yet" end
	local hum = ch:FindFirstChild("Humanoid")
	if not hum then return "no Humanoid yet" end
	local ok, hp = pcall(function() return hum.Health end)
	if not ok or type(hp) ~= "number" or hp <= 0 then return "not alive yet" end
	if not currentTool() then return "waiting for a weapon (deploy / equip first)" end
	local m = menuGuiName()
	if m then return "menu open: " .. m end
	local left = settleLeft()
	if left > 0 then return string.format("settling after spawn / class change (%.0fs left)", left) end
	return nil
end

--============================= GC PRIMITIVES ================================
local function isNumericEntry(e)
	if type(e) ~= "table" then return false end
	if e.type == "number" or e.vtt == 3 then
		return tonumber(e.value) ~= nil
	end
	return false
end

local function numericValueOf(e)
	if type(e) ~= "table" then return nil end
	return tonumber(e.value)
end

local function isFiniteNumber(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function tableKeyOf(e)
	local k = e.tbl or e.table or e.parent or e.tbladdr
	if k == nil then return nil end
	return tostring(k)
end

local function isEligible(e)
	if type(e) ~= "table" then return false end
	local rng = KEY_RANGE[e.key]
	if not rng then return false end
	if not isNumericEntry(e) then return false end
	local v = numericValueOf(e)
	if not isFiniteNumber(v) then return false end
	-- a field that already holds our target stays eligible, so a fresh scan of
	-- an already-patched table is not filtered down to nothing
	local ours = KEY_TARGETS[e.key]
	local alreadyOurs = (ours ~= nil and v == ours)
	if (not alreadyOurs) and (v < rng.min or v > rng.max) then return false end
	if WM.filterMode == "tables" then
		local t = tableKeyOf(e)
		if not t then return false end
		if not (WM.weaponSet and WM.weaponSet[t]) then return false end
	end
	return true
end

local function countEligible(entries, key)
	if not entries then return 0 end
	local n = 0
	for _, e in ipairs(entries) do
		if type(e) == "table" and e.key == key and isEligible(e) then n = n + 1 end
	end
	return n
end

local function rebuildWeaponSet(entries)
	local groups, anyTableInfo = {}, false
	for _, e in ipairs(entries) do
		if type(e) == "table" then
			local t = tableKeyOf(e)
			if t then
				anyTableInfo = true
				local g = groups[t]
				if not g then g = { m = 0, keys = {} }; groups[t] = g end
				if not g.keys[e.key] then
					g.keys[e.key] = true
					for _, m in ipairs(MARKER_KEYS) do
						if e.key == m then g.m = g.m + 1 end
					end
				end
			end
		end
	end
	local set, matched = {}, 0
	for t, g in pairs(groups) do
		if g.m >= MIN_MARKERS then set[t] = true; matched = matched + 1 end
	end
	return set, matched, anyTableInfo
end

-- returns ok, fields written, error, stale
-- "stale" means the cached addresses no longer point at live weapon tables, so
-- the cache is thrown away instead of being written into
local function applyCached(key, target)
	if not WM.cache then return false, 0, "no cache", false end
	local expected = countEligible(WM.cache, key)
	local t0 = clock()
	local ok, res = pcall(applygc, WM.cache, key, target)
	if not ok then return false, 0, tostring(res), false end
	local n = tonumber(res) or 0
	dbg(string.format("%s: %d of %d field(s) in %.2fs", key, n, expected, clock() - t0))
	if n == 0 and expected > 0 then
		WM.cache = nil
		WM.weaponSet = nil
		dbg("cache addresses are dead (0 fields matched) - dropped the cache")
		return false, 0, "the cached addresses are stale", true
	end
	return true, n, nil, false
end

-- usable = a scan or a successful read-back confirmed it recently. Time alone
-- never marks a cache stale in a way that costs a scan: an old cache is read
-- back first (see verifyCache), which is free.
local function cacheValid()
	if not WM.cache then return false end
	if (clock() - WM.verifiedAt) >= CACHE_TRUST then return false end
	return true
end

-- a cache that turned out to be dead is thrown away so the next explicit write
-- scans again. The toggles stay exactly as the user left them.
local function dropCache(reason)
	if not WM.cache then return end
	WM.cache = nil
	WM.weaponSet = nil
	dbg("cache dropped (" .. reason .. ")")
end

--====================== CACHE VERIFICATION (READ ONLY) ======================
-- Reads a sample of the cached values straight back out of memory. There is no
-- write anywhere in here, so the worst a misread can do is make us rescan.
local function readAt(addr, typ)
	local ok, v = pcall(memory_read, typ, addr)
	if ok and type(v) == "number" then return v end
	return nil
end

-- true = the field is still exactly what we scanned, false = it changed,
-- nil = we cannot even address it (not counted either way)
local function readMatches(e, expect)
	local a = tonumber(e.addr)
	if not a then return nil end
	local order = { "double", "float", "int" }
	if WM.readType then
		local rest = { WM.readType }
		for _, t in ipairs(order) do if t ~= WM.readType then table.insert(rest, t) end end
		order = rest
	end
	local tol = math.max(1e-9, math.abs(expect) * 1e-6)
	for _, t in ipairs(order) do
		local v = readAt(a, t)
		if v and math.abs(v - expect) <= tol then
			WM.readType = t
			return true
		end
	end
	return false
end

-- "alive"   = the addresses still hold the same weapon values (safe to write)
-- "dead"    = they hold something else (the game rebuilt its tables)
-- "unknown" = not enough readable fields to judge (treated as dead)
local function verifyCache()
	if not WM.cache then return "unknown" end
	local t0 = clock()
	local okn, fail, seen, tables = 0, 0, 0, {}
	for _, e in ipairs(WM.cache) do
		if seen >= VERIFY_SAMPLE or fail > VERIFY_MAX_FAIL then break end
		if type(e) == "table" and isNumericEntry(e) then
			local expect = numericValueOf(e)
			local marker = false
			for _, k in ipairs(VERIFY_KEYS) do if e.key == k then marker = true end end
			if marker and isFiniteNumber(expect) and expect ~= 0 then
				local t = tableKeyOf(e)
				if not (t and tables[t]) then
					if t then tables[t] = true end
					local m = readMatches(e, expect)
					if m ~= nil then
						seen = seen + 1
						if m then okn = okn + 1 else fail = fail + 1 end
					end
				end
			end
		end
	end
	local verdict
	if fail > VERIFY_MAX_FAIL then
		verdict = "dead"
	elseif (okn + fail) < VERIFY_MIN_OK then
		verdict = "unknown"
	elseif okn >= VERIFY_MIN_OK then
		verdict = "alive"
	else
		verdict = "unknown"
	end
	WM.lastVerdict = string.format("%s - %d of %d fields still match (%d changed, %.2fs, %s)",
		verdict, okn, seen, fail, clock() - t0, tostring(WM.readType))
	dbg("cache check: " .. WM.lastVerdict)
	return verdict
end

--============================= HEAVY JOBS ===================================
local function mergedScanKeys()
	local keys = {}
	for _, k in ipairs(CAPTURE_KEYS) do table.insert(keys, k) end
	for _, k in ipairs({ "Damage", "MuzzleVelocity" }) do table.insert(keys, k) end
	return keys
end

local function jobScan()
	local t0 = clock()
	warn("scanning the GC now - do not touch anything, do not switch class / weapon for about " .. SCAN_WARN .. " seconds")
	local keys = mergedScanKeys()
	local ok, entries = pcall(getgc, keys)
	if not ok then
		WM.cache = nil
		WM.weaponSet = nil
		fail("getgc failed: " .. tostring(entries))
		return
	end
	if type(entries) ~= "table" then
		WM.cache = nil
		fail("getgc returned " .. type(entries) .. " instead of a table - scan cancelled")
		return
	end
	if not alive() then dbg("scan aborted - player left the game"); return end
	local total = 0
	for _, e in ipairs(entries) do if type(e) == "table" then total = total + 1 end end

	local set, matched, anyTableInfo = rebuildWeaponSet(entries)
	local counts = {}
	for _, k in ipairs(CAPTURE_KEYS) do counts[k] = 0 end

	WM.cache       = entries
	WM.weaponSet   = set
	WM.scanKeys    = keys
	WM.filterMode  = "tables"
	WM.verifiedAt  = clock()
	WM.lastVerdict = "fresh scan - trusted"
	if (not anyTableInfo) or matched == 0 then
		WM.filterMode = "range"
		note("no weapon-table grouping available - falling back to value ranges")
	end
	for _, k in ipairs(CAPTURE_KEYS) do counts[k] = countEligible(entries, k) end
	WM.lastScan = clock()

	dbg(string.format("scan: %d entries in %.1fs, weapon tables matched: %d", total, clock() - t0, matched))
	dbg(string.format("cache ready: Spread=%d Penetration=%d Gravity=%d",
		counts.Spread, counts.Penetration, counts.Gravity))
	dbg(string.format("GC scan done in %.1fs - %d entries, %d weapon table(s), mode=%s",
		clock() - t0, total, matched, WM.filterMode))
	note(string.format("scan complete - %d entries, %d weapon tables", total, matched))
end

-- Makes sure a usable cache exists. This is only ever reached from a toggle
-- or a button - nothing calls it by itself. A cache that is not trusted is
-- read back first (read only, milliseconds); a real rebuild costs one scan.
local function ensureCache()
	if cacheValid() then
		dbg(string.format("reusing cache (last checked %.0fs ago)", clock() - WM.verifiedAt))
		return
	end
	if WM.cache then
		local verdict = verifyCache()
		if verdict == "alive" then
			WM.verifiedAt = clock()
			note("cache still matches - re-using it (" .. WM.lastVerdict .. ")")
			return
		end
		if verdict == "unknown" and not WM.warnedUnknown then
			WM.warnedUnknown = true
			warn("cannot read the cache back (unsafe Lua / memory_read off?) - one scan is needed before the next change")
		end
		dropCache(verdict == "dead" and "the cached weapon tables are gone (the game rebuilt them)" or "cache could not be verified")
	end
	jobScan()
end

-- the toggle that has to be on for a key to be worth writing
local KEY_STATE = { Spread = "spread", Penetration = "pen", Gravity = "flat" }

-- one cached write; a dead cache is rebuilt ONCE and the write retried, because
-- the user asked for this value right now
local function applyWithRetry(key, target)
	ensureCache()
	if not alive() then return false, 0, "player left the game" end
	local ok, n, err, stale = applyCached(key, target)
	if (not ok) and stale then
		dbg("cache was stale - one fresh scan, then retry " .. key)
		ensureCache()
		if not alive() then return false, 0, "player left the game" end
		ok, n, err = applyCached(key, target)
	end
	return ok, n, err
end

-- Spread / Max Pen / No Flatline all go through the scanned, weapon-table-only
-- cache now. There is no unfiltered global write left in this script.
local function jobApplyKey(key, target)
	local st = KEY_STATE[key]
	if st and not WM.state[st] then
		dbg(key .. " job skipped - the module was switched off again")
		return
	end
	local ok, n, err = applyWithRetry(key, target)
	if not ok then
		fail("could not apply " .. key .. ": " .. tostring(err))
		return
	end
	if n == 0 then
		warn(key .. ": no live weapon " .. key .. " field found yet - deploy into a match, then flip the module on again")
		return
	end
	note(string.format("%s now %s (%d field(s))", key, tostring(target), n))
end

local function jobFlatline()
	jobApplyKey("Gravity", GRAVITY_TARGET)
end

local function jobRestoreGravity()
	local ok, n, err = applyWithRetry("Gravity", GRAVITY_RESTORE)
	if not ok then
		fail("could not restore Gravity: " .. tostring(err))
		return
	end
	WM.state.flat = false
	syncToggles()
	if n == 0 then
		warn("Restore Gravity: no live Gravity field found - deploy into a match first")
		return
	end
	note(string.format("Gravity restored to %d (%d field(s))", GRAVITY_RESTORE, n))
end

-- Puts every module that is switched on back the way the user left it. Only
-- the Re-apply button calls this now - nothing runs it by itself. The cache is
-- read back first, so it is instant while the game is still using the same
-- tables, and only a real rebuild costs one fresh scan.
local function jobRestoreMods()
	local wanted = {}
	if WM.state.spread then table.insert(wanted, { "Spread", SPREAD_TARGET, "spread" }) end
	if WM.state.pen    then table.insert(wanted, { "Penetration", PEN_TARGET, "pen" }) end
	if WM.state.flat   then table.insert(wanted, { "Gravity", GRAVITY_TARGET, "flat" }) end
	if #wanted == 0 then
		dbg("restore: no module is switched on")
		return
	end
	local did, problems = {}, {}
	for _, m in ipairs(wanted) do
		local key, target, st = m[1], m[2], m[3]
		local ok, n, err = applyWithRetry(key, target)
		if ok and n > 0 then
			table.insert(did, key .. "=" .. n)
		else
			WM.state[st] = false
			table.insert(problems, key .. " (" .. tostring(err or "no live field") .. ")")
		end
	end
	if #problems > 0 then
		syncToggles()
		warn("could not put back " .. table.concat(problems, ", ") .. " - that module was switched off, flip it to retry")
	end
	if #did > 0 then note("restored: " .. table.concat(did, " ")) end
end

--============================= OPERATION QUEUE ==============================
local pump
pump = function()
	if WM.stopped or WM.busy then return end
	local job = WM.queue[1]
	if not job then return end
	local reason = guardReason()
	if reason then
		if not job.heldOnce then
			job.heldOnce = true
			warn("waiting to run '" .. job.name .. "' - " .. reason)
		elseif WM.debug and (clock() - WM.holdLogged) > HOLD_LOG_INTERVAL then
			WM.holdLogged = clock()
			dbg(string.format("still holding '%s' back - %s", job.name, reason))
		end
		task.delay(2, function() pump() end)
		return
	end
	table.remove(WM.queue, 1)
	WM.busy = true
	WM.lastOp = job.name
	task.spawn(function()
		local t0 = clock()
		local warned = WM.warnCount
		dbg("OP START: " .. job.name)
		local ok, err = pcall(job.fn)
		WM.busy = false
		if ok then
			if WM.warnCount > warned then
				log(string.format("done - %s (%.1fs)", job.name, clock() - t0))
			end
			dbg(string.format("OP DONE: %s (%.1fs)", job.name, clock() - t0))
		else
			fail(string.format("OP FAILED: %s -> %s", job.name, tostring(err)))
		end
		WM.lastOp = "(idle)"
		task.delay(0.3, function() pump() end)
	end)
end

local function enqueue(name, fn)
	if WM.stopped then dbg("ignored '" .. name .. "' - script is stopped"); return end
	table.insert(WM.queue, { name = name, fn = fn })
	if #WM.queue > 1 or WM.busy then
		dbg("queued: " .. name .. " (waiting for the operation in front of it)")
	else
		dbg("queued: " .. name)
	end
	pump()
end

--============================= TOGGLES ======================================
local function toggle(key, on)
	WM.state[key] = on
	if key == "recoil" then
		local ok, msg = setRecoil(on)
		dbg("No Recoil " .. (on and "on" or "off") .. " -> " .. tostring(msg))
		if not ok then notify("No Recoil", msg, "error", 6) end
		return
	end
	if key == "spread" then
		if on then
			enqueue("No Spread ON (Spread -> " .. SPREAD_TARGET .. ")", function()
				jobApplyKey("Spread", SPREAD_TARGET)
			end)
		else
			note("No Spread off - the value stays patched. Rejoin to reset it.")
		end
		return
	end
	if key == "pen" then
		if on then
			enqueue("Max Pen ON (Penetration -> " .. PEN_TARGET .. ")", function()
				jobApplyKey("Penetration", PEN_TARGET)
			end)
		else
			note("Max Pen off - the value stays patched. Rejoin to reset it.")
		end
		return
	end
	if key == "flat" then
		if on then
			-- uses the shared cache: instant when it is warm, otherwise the same one
			-- scan as No Spread / Max Pen
			enqueue("No Flatline ON (Gravity -> " .. GRAVITY_TARGET .. ")", jobFlatline)
		else
			note("No Flatline off - gravity stays " .. GRAVITY_TARGET .. " until you press Restore Gravity.")
		end
		return
	end
end

