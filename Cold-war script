--============================= WATCHER ======================================
task.spawn(function()
	local gone = 0
	while not WM.stopped do
		task.wait(1)
		if WM.stopped then break end
		if game.PlaceId ~= WM.placeId then
			WM.stopped = true
			WM.queue = {}
			log("place changed (rejoining / new server) - watcher stopped, no further GC calls")
			break
		end
		local p = lp()
		if not p then
			gone = gone + 1
			if gone >= 3 then
				WM.stopped = true
				WM.queue = {}
				log("LocalPlayer is gone - watcher stopped, no further GC calls")
				break
			end
		else
			gone = 0
			local ch = p.Character
			if ch ~= WM.lastChar then
				WM.lastChar = ch
				WM.lastChange = clock()
				WM.needAuto = true
				dbg(string.format("spawn / class change - holding GC operations for %ds", SETTLE_AFTER_CHANGE))
			end
			if WM.state.recoil then setRecoil(true) end
			if WM.needAuto and alive() and guardReason() == nil
				and (clock() - WM.lastAuto) >= MIN_AUTO_INTERVAL then
				WM.needAuto = false
				if WM.state.spread or WM.state.pen or WM.state.flat then
					enqueue("auto re-apply (cache)", function() jobReapply(true) end)
				end
			end
		end
	end
end)

