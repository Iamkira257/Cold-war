local function getRem()
	local ok, r = pcall(function() return Rem end)
	if ok and r and r.Alive then return r end
	return nil
end

local function loadRem()
	-- rem.lua is the live library file; anything else 404s and the HTML body
	-- would blow up loadstring, so validate the source before running it.
	local urls = {
		"https://raw.githubusercontent.com/9mfg/rem-ui/main/rem.lua",
	}
	for _, url in ipairs(urls) do
		local ok, src = pcall(function() return game:HttpGet(url) end)
		if ok and type(src) == "string" and #src > 200
			and not string.find(src, "^404", 1)
			and not string.find(src, "Not Found", 1, true) then
			pcall(function() loadstring(src)() end)
			local r = getRem()
			if r then return r end
		end
	end
	return nil
end

