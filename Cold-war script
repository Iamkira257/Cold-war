--============================= WATCHER ======================================
task.spawn(function()
	local gone = 0
	local hb = clock()
	while not WM.stopped do
		task.wait(1)
		if WM.stopped then break end
		if game.PlaceId ~= WM.placeId then
			WM.stopped = true
			WM.queue = {}
			log("place changed (rejoining / new server) - watcher stopped, no further GC calls")
			break
		end
		local p = lp()
		if not p then
			gone = gone + 1
			if gone >= 3 then
				WM.stopped = true
				WM.queue = {}
				log("LocalPlayer is gone - watcher stopped, no further GC calls")
				break
			end
		else
			gone = 0
			-- A respawn, a death, a class swap or the class menu is deliberately a
			-- NO-OP here: no rescan, no re-apply, no cache drop, no queueing. The
			-- cache and the toggles stay exactly as they are, so the patched values
			-- just keep going. The only thing noted is the moment it happened, so
			-- queued work still waits for the spawn / settle to finish first.
			local ch = p.Character
			if ch ~= WM.lastChar then
				WM.lastChar = ch
				WM.lastChange = clock()
				dbg("character changed - nothing to do, the mods stay as they are")
			end
			-- Keep the queue moving (after the bookkeeping above, so a fresh spawn is
			-- already accounted for by the guard). Nothing is scanned or re-applied by
			-- itself and no cache is dropped here, but a job you asked for that is
			-- being held back is retried once a second until it can run. This is the
			-- safety net task.delay was supposed to be - it does not run its callback
			-- in this build, which is what let the whole queue stall before.
			if (not WM.busy) and #WM.queue > 0 then pcall(pump) end
			-- No Recoil: checked every second, written only if the game cleared it
			if WM.state.recoil then
				local _, msg, wrote = setRecoil(true)
				if wrote == 1 then dbg("No Recoil: " .. tostring(msg)) end
			end
			-- crash trail: the operation in flight, the cache state, memory in use
			if (clock() - hb) >= HEARTBEAT_INTERVAL then
				hb = clock()
				local kb, mb
				pcall(function() kb = gcinfo() end)
				pcall(function() mb = game:GetService("Stats"):GetTotalMemoryUsageMb() end)
				if type(kb) ~= "number" then kb = nil end
				if type(mb) ~= "number" then mb = nil end
				local c = "none"
				if WM.cache then c = cacheValid() and "ready" or "due a read-back" end
				log(string.format("heartbeat - lastOp=%s, queue=%d, cache=%s, lua=%s, client=%s",
					WM.lastOp, #WM.queue, c,
					kb and string.format("%.0fKB", kb) or "n/a",
					mb and string.format("%.0fMB", mb) or "n/a"))
			end
		end
	end
end)

